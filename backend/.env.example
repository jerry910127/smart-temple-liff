# LINE Bot 憑證 (取自 LINE Developers Console)
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# NVIDIA NIM API Key (取自 NVIDIA API Catalog)
NVIDIA_API_KEY=nvapi-your_nvidia_api_key_here
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct

# 可接受之 LINE Login / MINI App Channel ID，以逗號分隔
LINE_LOGIN_CHANNEL_IDS=2011668576,2011672732,2011672733,2011672734

# 只允許正式前端呼叫瀏覽器 API；本機開發時可另加 http://127.0.0.1:8765
ALLOWED_ORIGINS=https://jerry910127.github.io

# /logs 管理密鑰；未設定時端點會回傳 404
ADMIN_LOG_TOKEN=replace_with_a_long_random_secret

# 實境解謎啟動碼的 SHA-256 雜湊，以逗號分隔；不要填入明碼
QUEST_ACCESS_CODE_HASHES=replace_with_sha256_hex_digest
